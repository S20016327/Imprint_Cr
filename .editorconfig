# EditorConfig — https://editorconfig.org
# Unifies editor formatting across the Imprint_Cr project.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,css,scss,sass,less,html,htm,vue,svelte,yml,yaml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.py]
indent_size = 4
max_line_length = 100

[*.{go,rs,c,cpp,h,hpp,java,kt}]
indent_style = tab

[Makefile]
indent_style = tab
