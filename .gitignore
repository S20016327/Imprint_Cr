# ---------------------------------------------------------------------------
# Imprint_Cr — Git ignore rules
# ---------------------------------------------------------------------------

# --- Secrets & environment ------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
.netrc

# --- Dependencies ---------------------------------------------------------
node_modules/
jspm_packages/
.pnp
.pnp.js
bower_components/
vendor/
.venv/
venv/
env/
__pypackages__/
packages/*/node_modules/

# --- Build output ---------------------------------------------------------
dist/
build/
out/
target/
bin/
obj/
*.egg-info/
.eggs/
.next/
.nuxt/
.output/
.parcel-cache/
.turbo/
.svelte-kit/
.wrangler/
coverage/
*.tsbuildinfo

# --- Caches ---------------------------------------------------------------
.cache/
.npm/
.yarn/
.pnpm-store/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
__pycache__/
*.py[cod]
*.class
*.o
*.a
*.so
*.dylib
*.dll

# --- Logs & temp ----------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.swp
*.swo
*~

# --- OS / editor ----------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.sublime-workspace

# --- Misc -----------------------------------------------------------------
.arena/
*.sqlite
*.sqlite3
*.db
